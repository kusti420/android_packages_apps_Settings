<resources>
    <!-- Bluetooth settings: AirPods battery levels, read by SystemUI (IchthysPodBatteryController) from the connected earbuds themselves -->
    <string name="ichthys_airpods_battery_title">AirPods battery levels</string>
    <string name="ichthys_airpods_battery_summary">Show the battery of each earbud and the case for connected AirPods</string>
    <!-- Bluetooth settings: when the earbuds can't be asked directly, use the status that nearby AirPods broadcast over Bluetooth LE instead. Off by default: a broadcast can't be tied to the connected pair -->
    <string name="ichthys_airpods_battery_broadcast_fallback_title">Use nearby broadcasts as a fallback</string>
    <string name="ichthys_airpods_battery_broadcast_fallback_summary">If the connected AirPods can\'t be asked directly, read the levels that nearby AirPods broadcast. Less exact, and it may show someone else\'s pair</string>
</resources>
