    <string name="ichthys_gallery_hide_art_caches_summary">Hide folders that hold only cover art, such as music players\' art caches</string>
    <string name="ichthys_gallery_folders_title">Hidden folders</string>
    <string name="ichthys_gallery_cleanup_footer">Folders are hidden with a .nomedia file; nothing is moved or deleted. Turn a folder off to always show it. Cover art stored next to your music stays visible, since hiding it would hide the songs too.</string>
