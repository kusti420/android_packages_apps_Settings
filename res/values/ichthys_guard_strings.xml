<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- IchthysOS Guard: per-app network firewall and activity monitor (Settings homepage row,
         GuardActivity, notifications and Quick Settings tiles). -->
    <string name="ichthys_guard_title">Guard</string>
    <string name="ichthys_guard_summary">Per-app firewall, trackers and live network activity</string>
    <string name="ichthys_guard_navigate_up">Navigate up</string>

    <!-- The Guard row on the stock App info page: opens that app's Guard page. -->
    <string name="ichthys_guard_app_info_summary">Network, trackers and data access</string>

    <!-- Per-app shields that are shown both in Guard's Data access card and on a stock page (the
         Usage access page, the No location page). Both read these, so the wording can't drift.
         One polarity everywhere: switch on = protected. -->
    <string name="ichthys_shield_usage_title">Hide usage history</string>
    <string name="ichthys_shield_usage_on">Sees an empty usage history</string>
    <string name="ichthys_shield_usage_off">Sees which apps you used and when</string>
    <string name="ichthys_shield_location_on">Never gets a location, as if indoors</string>
    <string name="ichthys_shield_location_off">Gets your location when allowed</string>

    <!-- Notification channels -->
    <string name="ichthys_guard_channel_alerts">Guard alerts</string>
    <string name="ichthys_guard_channel_alerts_summary">New apps: what they embed, with one-tap network and tracker controls</string>
    <string name="ichthys_guard_channel_reports">Guard reports</string>
    <string name="ichthys_guard_channel_reports_summary">Weekly summary of trackers seen and blocked</string>

