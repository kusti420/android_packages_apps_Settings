<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- IchthysOS Guard: per-app network firewall and activity monitor (Settings homepage row,
         GuardActivity, notifications and Quick Settings tiles). -->
    <string name="ichthys_guard_title">Guard</string>
    <string name="ichthys_guard_summary">Per-app firewall, trackers and live network activity</string>
    <string name="ichthys_guard_navigate_up">Navigate up</string>
    <!-- IchthysOS: Guard runs for the device owner (system user) only; shown when another user or
         a profile opens it. -->
    <string name="ichthys_guard_owner_only">Guard is managed by the phone\'s owner</string>

    <!-- The Guard row on the stock App info page: opens that app's Guard page. -->
    <string name="ichthys_guard_app_info_summary">Network, trackers and data access</string>

    <!-- Per-app shields that are shown both in Guard's Data access card and on a stock page (the
         Usage access page, the No location page). Both read these, so the wording can't drift.
         One polarity everywhere: switch on = protected. -->
    <string name="ichthys_shield_usage_title">Hide usage history</string>
    <string name="ichthys_shield_usage_on">Sees an empty usage history</string>
    <string name="ichthys_shield_usage_off">Sees which apps you used and when</string>
    <string name="ichthys_shield_location_on">Never gets a location, as if indoors</string>
    <string name="ichthys_shield_location_off">Gets your location when allowed</string>

    <!-- Notification channels -->
    <string name="ichthys_guard_channel_alerts">Guard alerts</string>
    <string name="ichthys_guard_channel_alerts_summary">New apps: what they embed, with a one-tap network block</string>
    <string name="ichthys_guard_channel_reports">Guard reports</string>
    <string name="ichthys_guard_channel_reports_summary">Weekly summary of trackers seen and blocked</string>

    <!-- Quick Settings tiles -->
    <string name="ichthys_guard_tile_lockdown">Lockdown</string>
    <string name="ichthys_guard_tile_lockdown_on">Apps offline</string>
    <string name="ichthys_guard_tile_off">Off</string>
    <string name="ichthys_guard_tile_pause">Pause Guard</string>
    <string name="ichthys_guard_tile_paused">Guard paused</string>
    <string name="ichthys_guard_tile_paused_until">until <xliff:g id="time">%1$s</xliff:g></string>
    <string name="ichthys_guard_tile_pause_duration">5 min</string>

    <!-- First-launch review sheet (FirstLaunchActivity): shown when the user opens a newly
         installed, still quarantined app and taps Review in the system's suspended-app dialog. -->
    <string name="ichthys_guard_first_launch_intro">This app hasn\'t run yet. Choose how Guard treats it before it opens.</string>
    <!-- IchthysOS: the same sheet for an app Guard paused after weeks unused (auto-tighten). -->
    <string name="ichthys_guard_first_launch_intro_dormant">Guard paused this app because you hadn\'t used it for a while. Choose how Guard treats it before it opens again.</string>
    <string name="ichthys_guard_first_launch_installer">Installed by <xliff:g id="installer">%1$s</xliff:g></string>
    <string name="ichthys_guard_first_launch_section_trackers">Trackers</string>
    <string name="ichthys_guard_first_launch_section_permissions">Permissions requested</string>
    <string name="ichthys_guard_first_launch_section_recommended">Recommended</string>
    <string name="ichthys_guard_first_launch_no_trackers">No known trackers</string>
    <string name="ichthys_guard_first_launch_scan_pending">Tracker scan not finished yet</string>
    <plurals name="ichthys_guard_first_launch_trackers_found">
        <item quantity="one"><xliff:g id="count">%d</xliff:g> tracker found</item>
        <item quantity="other"><xliff:g id="count">%d</xliff:g> trackers found</item>
    </plurals>
    <string name="ichthys_guard_first_launch_no_permissions">No runtime permissions requested</string>
    <string name="ichthys_guard_first_launch_loading">Loading…</string>

    <!-- Permission groups, plain language -->
    <string name="ichthys_guard_perm_location">Location</string>
    <string name="ichthys_guard_perm_camera">Camera</string>
    <string name="ichthys_guard_perm_microphone">Microphone</string>
    <string name="ichthys_guard_perm_contacts">Contacts</string>
    <string name="ichthys_guard_perm_sms_calls">SMS and calls</string>
    <string name="ichthys_guard_perm_storage_media">Storage and media</string>
    <string name="ichthys_guard_perm_nearby_devices">Nearby devices</string>
    <string name="ichthys_guard_perm_notifications">Notifications</string>
    <string name="ichthys_guard_perm_internet">Full internet access</string>

    <!-- Recommendation lines: topic, chosen value, one-line reason -->
    <string name="ichthys_guard_advice_topic_network">Network</string>
    <string name="ichthys_guard_advice_topic_trackers">Trackers</string>
    <string name="ichthys_guard_advice_topic_exceptions">Data access</string>
    <string name="ichthys_guard_advice_value_network_open">Open, monitored</string>
    <string name="ichthys_guard_advice_value_network_unused">Not requested</string>
    <string name="ichthys_guard_advice_value_trackers_strict">Strict</string>
    <string name="ichthys_guard_advice_value_trackers_known">Block known trackers</string>
    <string name="ichthys_guard_advice_value_trackers_off">Off</string>
    <!-- IchthysOS: shown instead of the three values above while per-app tracker rules aren't
         enforced (HostRules.ENFORCED in model/Rules.kt). -->
    <string name="ichthys_guard_advice_value_trackers_not_enforced">System blocklist</string>
    <string name="ichthys_guard_advice_value_exceptions_closed">Protected</string>
    <string name="ichthys_guard_advice_network_shielded">Shielded default: connections allowed, every one monitored.</string>
    <string name="ichthys_guard_advice_network_not_requested">It doesn\'t ask for internet access, so there is nothing to restrict.</string>
    <string name="ichthys_guard_advice_trackers_strict">Several trackers found: only hosts you allow are reachable.</string>
    <!-- IchthysOS: the two lines below are worded for HostRules.ENFORCED = false (per-app tracker
         rules saved but not applied). Revisit them when host rules are enforced. -->
    <string name="ichthys_guard_advice_trackers_known">Trackers found. Guard can\'t block them per app yet; the system-wide blocklist still stops common ones.</string>
    <!-- IchthysOS: no "strict mode" while per-app tracker rules aren't enforced. -->
    <string name="ichthys_guard_advice_trackers_browser">A browser: per-app tracker rules would break websites, so the default stays. The system-wide blocklist still applies.</string>
    <string name="ichthys_guard_advice_trackers_none">None found. The system-wide blocklist still applies.</string>
    <string name="ichthys_guard_advice_trackers_unknown">Scan not available yet, so the default stays.</string>
    <string name="ichthys_guard_advice_exceptions_closed">Contacts, clipboard and sensors stay protected until you give it real access.</string>

    <!-- First-launch buttons -->
    <string name="ichthys_guard_first_launch_apply">Apply recommended</string>
    <string name="ichthys_guard_first_launch_customize">Customize</string>
    <string name="ichthys_guard_first_launch_as_is">Open as-is</string>
    <string name="ichthys_guard_first_launch_failed">Couldn\'t release <xliff:g id="app">%1$s</xliff:g></string>

    <!-- IchthysOS: the Settings hub "Protected" card (ShoalProtectedPreference) when some
         protections are off: names them (comma-separated labels such as "Clipboard lockdown"). -->
    <string name="ichthys_protected_summary_off">Off: <xliff:g id="protections">%1$s</xliff:g></string>
    <!-- IchthysOS: the No location page (LocationNoFixSettings) when no app requests location. -->
    <string name="ichthys_location_nofix_empty">No app you installed asks for your location.</string>
</resources>
