<!-- IchthysOS: extra privileged permissions for Settings (ro.control_privapp_permissions=enforce),
     merged with frameworks/base/data/etc/com.android.settings.xml. They come from the retired
     org.ichthys.guard priv-app, whose UI now lives in Settings (com.android.settings.ichthys.guard).
     WRITE_SECURE_SETTINGS and PACKAGE_USAGE_STATS are already in the base file.
     org.ichthys.permission.MANAGE_ICHTHYS_GUARD is signature-only, so it needs no entry. -->
<permissions>
    <privapp-permissions package="com.android.settings">
        <permission name="android.permission.READ_NETWORK_USAGE_HISTORY" />
        <permission name="android.permission.GET_APP_OPS_STATS" />
    </privapp-permissions>
</permissions>
